{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/images/*", "/js/*", "*.{css,js,jpg,png,gif,ico,svg,woff,woff2,ttf,eot}"]
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/services",
      "rewrite": "/services.html"
    },
    {
      "route": "/products",
      "rewrite": "/products.html"
    },
    {
      "route": "/industries",
      "rewrite": "/industries.html"
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/how-we-work",
      "rewrite": "/how-we-work.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "application/javascript",
    ".html": "text/html"
  }
}
